# Local Docker database from ../docker-compose.yml (port 5436). Point this at your own PostgreSQL if you have one.
DATABASE_URL="postgresql://event_rsvp:event_rsvp_dev@localhost:5436/event_rsvp?schema=public"
# Separate database used by `npm test`; its tables are wiped on every test run.
TEST_DATABASE_URL="postgresql://event_rsvp:event_rsvp_dev@localhost:5436/event_rsvp_test?schema=public"
PORT=4000
FRONTEND_URL="http://localhost:3001"
